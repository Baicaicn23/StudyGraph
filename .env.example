# 模型提供方：mock（默认，零 API 消耗）或 openai（任何 OpenAI 兼容平台）
STUDYGRAPH_LLM_PROVIDER=mock
STUDYGRAPH_MODEL=study-mock

# 接入真实模型时（provider=openai）
STUDYGRAPH_OPENAI_BASE_URL=https://api.deepseek.com/v1
STUDYGRAPH_OPENAI_API_KEY=在此填写你的密钥
# 推理型模型建议留 4096，避免输出被"思考"吃光导致空回答
STUDYGRAPH_MAX_OUTPUT_TOKENS=4096

# 运行数据（默认即可）
STUDYGRAPH_DATABASE_PATH=data/studygraph.db
STUDYGRAPH_KNOWLEDGE_ROOT=data/knowledge

# Embedding（向量检索）：mock（默认，确定性零成本）或 openai（OpenAI 兼容 /embeddings）
STUDYGRAPH_EMBEDDING_PROVIDER=mock
STUDYGRAPH_EMBEDDING_MODEL=text-embedding-3-small
STUDYGRAPH_EMBEDDING_DIM=256

# 单回合允许的最大工具轮数
STUDYGRAPH_MAX_TOOL_ROUNDS=6

# 上传文件大小上限（字节）
STUDYGRAPH_MAX_UPLOAD_BYTES=5000000
