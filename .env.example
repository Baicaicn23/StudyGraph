# 模型提供方：mock（默认，零 API 消耗）或 openai（任何 OpenAI 兼容平台）
ZHIJI_LLM_PROVIDER=mock
ZHIJI_MODEL=study-mock
# 模型路由：可选的小/大模型档位（留空则都用 ZHIJI_MODEL）
ZHIJI_MODEL_SMALL=
ZHIJI_MODEL_LARGE=
# 每日 token 预算（0 = 不限制）；超限动作：block（默认）
ZHIJI_DAILY_TOKEN_BUDGET=0
ZHIJI_BUDGET_EXCEEDED_ACTION=block

# 接入真实模型时（provider=openai）
# DeepSeek 示例：模型名 deepseek-flash（V4.1-Flash，2026-09 GA）
ZHIJI_OPENAI_BASE_URL=https://api.deepseek.com/v1
ZHIJI_OPENAI_API_KEY=在此填写你的密钥
# 推理型模型建议留 4096，避免输出被"思考"吃光导致空回答
ZHIJI_MAX_OUTPUT_TOKENS=4096

# 运行数据（默认即可）
ZHIJI_DATABASE_PATH=data/zhiji.db
ZHIJI_KNOWLEDGE_ROOT=data/knowledge

# Embedding（向量检索）：mock（默认，确定性零成本，仅共享子串相似）或 openai（OpenAI 兼容 /embeddings）
# 中文检索强烈推荐接真模型——硅基流动 bge-m3 免费、中文效果好：siliconflow.cn 注册
# 注意：主模型是 DeepSeek 时它没有 /embeddings，向量服务要单独配 BASE_URL/KEY
# ZHIJI_EMBEDDING_PROVIDER=openai
# ZHIJI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# ZHIJI_EMBEDDING_API_KEY=sk-xxxx
# ZHIJI_EMBEDDING_MODEL=Pro/BAAI/bge-m3
# ZHIJI_EMBEDDING_DIM=1024
ZHIJI_EMBEDDING_PROVIDER=mock
ZHIJI_EMBEDDING_MODEL=text-embedding-3-small
ZHIJI_EMBEDDING_DIM=256

# 单回合允许的最大工具轮数
ZHIJI_MAX_TOOL_ROUNDS=6

# 轮级推理力度（可选）：auto = 按意图自动附加 reasoning_effort（讲解/出题 max，
# 计算/闲聊 low，其余交给模型）。仅推理模型 + 白名单 provider（DeepSeek/GLM）生效；
# 普通 deepseek-chat 不要开。留空 = 不附加（默认）
# ZHIJI_REASONING_EFFORT=auto

# 工具执行：单次超时（秒）与可重试错误的最大重试次数
ZHIJI_TOOL_TIMEOUT_SECONDS=10
ZHIJI_TOOL_MAX_RETRIES=2

# 上下文：超过该条数后压缩较早历史
ZHIJI_MAX_HISTORY_MESSAGES=24

# 上传文件大小上限（字节）
ZHIJI_MAX_UPLOAD_BYTES=5000000

# MCP 外部工具（JSON 数组；留空则关闭）。示例接官方 Filesystem server：
# ZHIJI_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
ZHIJI_MCP_SERVERS=

# ---- 联网搜索（可选）----
# 质量排序：DeepSeek 原生搜索（自动）> 博查 > Tavily ≈ 必应+DDG 双引擎
# 用 DeepSeek 做主模型（base_url 含 deepseek）时，web_search 自动走 DeepSeek 原生
# 联网搜索（服务端搜索+抓网页+基于全文整理答案，复用同一把 Key，质量最好）；
# ZHIJI_DEEPSEEK_SEARCH=1/0 可强制开/关。失败自动回落到下面两条。
# ZHIJI_DEEPSEEK_SEARCH=
# 博查（付费，中文最稳）：open.bochaai.com 注册
# ZHIJI_BOCHA_API_KEY=
# Tavily（免费额度够用）：tavily.com 注册
# ZHIJI_TAVILY_API_KEY=tvly-xxxx
