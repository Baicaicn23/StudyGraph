    <Box style={{ flexDirection: 'row', height: 56, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 420 }}>检索准确性 / 可追溯</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 110 }}>达标</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', width: 555 }}>35 题考卷；接真实向量 35/35；引用精确到页</Text>
