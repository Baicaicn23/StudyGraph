<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, position: 'relative', fontFamily: 'PingFang SC' }}>

  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#1E4FA8' }} />
  <Text style={{ position: 'absolute', left: 76, top: 21, fontSize: 15, color: '#C9D8EF', letterSpacing: 1 }}>知迹 · 答辩汇报</Text>
  <Text style={{ position: 'absolute', left: 1010, top: 21, width: 194, textAlign: 'right', fontSize: 15, color: '#C9D8EF' }}>02 · 技术选型与架构</Text>

  <Box style={{ position: 'absolute', left: 76, top: 92, width: 1128 }}>
    <Text style={{ fontSize: 31, fontWeight: 'bold', color: '#0E3F8C' }}>选型原则是「零运维、可离线、可评测」，不是追新</Text>
    <Text style={{ fontSize: 15.5, color: '#4A5568', marginTop: 10 }}>每一层都写清「承担什么」与「为什么不用更常见的替代方案」，便于评审追问</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 186, width: 1128, height: 40, flexDirection: 'row', alignItems: 'center', background: '#1E4FA8', borderRadius: 6, paddingLeft: 14 }}>
    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', width: 130 }}>层次</Text>
    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', width: 250 }}>选型</Text>
    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', width: 320 }}>承担什么</Text>
    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', width: 390 }}>为什么不选更常见的替代方案</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 230, width: 1128, height: 354, flexDirection: 'column' }}>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>编排</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>LangGraph 显式状态图</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>回合路由、工具循环、检查点、中断恢复</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>自研状态机要重复实现断点与中断，成本更高</Text>
    </Box>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>服务</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>FastAPI + SSE</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>流式下发步骤、回传人工确认结果</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>同步框架难以做到「边算边推」，过程不可见</Text>
    </Box>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>存储</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>SQLite（FTS5 + 向量表）</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>单文件承载全部业务数据与检索索引</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>换 MySQL 会牺牲中文检索与离线演示，收益为零</Text>
    </Box>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>检索</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>trigram 全文 + 向量 + LIKE + 加权 RRF</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>中文短词、同义异名、语义近似的多路覆盖</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>纯向量会漏专有名词与两字词，纯关键词漏同义</Text>
    </Box>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>前端</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>Next.js 16（App Router）</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>页面路由、流式渲染、交互态管理</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>纯 SPA 处理流式与多页状态更绕</Text>
    </Box>

    <Box style={{ flexDirection: 'row', height: 58, alignItems: 'center', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, color: '#1A2230', width: 130 }}>工具协议</Text>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1E4FA8', width: 250 }}>MCP（自写 stdio 客户端）</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 320 }}>外部工具即插即用、跨宿主复用</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', width: 390 }}>自研协议没有生态，也谈不上复用</Text>
    </Box>

  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 596, width: 1128, height: 46, background: '#F0F5FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#1E4FA8' }}>
      结果：整条链路可在离线状态跑通（测试与评测零 API 消耗），这是能反复验证的前提
    </Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, bottom: 24, width: 1128, height: 22, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>知迹 · 基于大模型智能体的 AI 教育学习系统</Text>
    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0E3F8C' }}>04 / 11</Text>
  </Box>

</Slide>
