<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', fontFamily: 'PingFang SC, Hiragino Sans GB, sans-serif' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 40, height: 56, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>知迹</Text>
        <Box style={{ width: 1, height: 16, background: '#5B8FD9' }} />
        <Text style={{ fontSize: 15, color: '#C9DDF5' }}>Agent 工程化实践</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 0, right: 40, height: 56, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#A9C6EF' }}>问题 · 三道坎的具体形态</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 56, left: 40, width: 1200, height: 92, flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>可恢复、可拦截、可度量：Agent 落地的三道坎</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>每道坎背后都是一个具体的、会真实发生的失效场景</Text>
    </Box>

<Box style={{ position: 'absolute', top: 160, left: 40, width: 1200, height: 148, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 22px', gap: 22 }}>
            <Box style={{ width: 52, height: 52, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 27, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
            </Box>
            <Box style={{ width: 150, justifyContent: 'center' }}>
                <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#0E3F8C' }}>可恢复</Text>
            </Box>
            <Box style={{ flex: 1, gap: 6 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.55 }}>失效场景：会话崩在第 7 步，前 6 步的检索与工具调用全部作废</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>为什么难：状态在消息列表里，进程一挂就没了</Text>
            </Box>
            <Box style={{ width: 340, background: '#E8EFF8', borderRadius: 5, padding: '12px 14px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', lineHeight: 1.6 }}>LangGraph 的 checkpointer 机制正是为此刻态而设计</Text>
            </Box>
        </Box>
<Box style={{ position: 'absolute', top: 322, left: 40, width: 1200, height: 148, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 22px', gap: 22 }}>
            <Box style={{ width: 52, height: 52, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 27, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
            </Box>
            <Box style={{ width: 150, justifyContent: 'center' }}>
                <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#0E3F8C' }}>可拦截</Text>
            </Box>
            <Box style={{ flex: 1, gap: 6 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.55 }}>失效场景：模型幻觉出一个被禁工具名并真的发起调用</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>为什么难：只在 schema 层裁剪工具，执行层没有第二道判定</Text>
            </Box>
            <Box style={{ width: 340, background: '#E8EFF8', borderRadius: 5, padding: '12px 14px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', lineHeight: 1.6 }}>schema 层不够 —— 模型能「说出」工具名并失败</Text>
            </Box>
        </Box>
<Box style={{ position: 'absolute', top: 484, left: 40, width: 1200, height: 148, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 22px', gap: 22 }}>
            <Box style={{ width: 52, height: 52, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 27, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
            </Box>
            <Box style={{ width: 150, justifyContent: 'center' }}>
                <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#0E3F8C' }}>可度量</Text>
            </Box>
            <Box style={{ flex: 1, gap: 6 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.55 }}>失效场景：改了一行检索权重，重跑一次看着更好了</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>为什么难：没有固定考卷，波动和真实提升混在一起</Text>
            </Box>
            <Box style={{ width: 340, background: '#E8EFF8', borderRadius: 5, padding: '12px 14px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', lineHeight: 1.6 }}>τ-bench 实测 pass^1 ≈ 61%、pass^8 &lt; 25%</Text>
            </Box>
        </Box>

    <Box style={{ position: 'absolute', top: 648, left: 40, width: 1200, height: 56, background: '#E8EFF8', borderTop: '2px solid #1E4FA8', flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 12 }}>
        <Box style={{ width: 4, height: 24, background: '#1E4FA8' }} />
        <Text style={{ fontSize: 19, color: '#0E3F8C', fontWeight: 'bold' }}>知迹把这三道坎都当作必须用工程手段解决的问题 —— 后面每一页对应其中一道</Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 8, left: 40, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>知迹 · 赛道十三 · 智慧教育</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 8, right: 40, flexDirection: 'row', alignItems: 'center', gap: 4 }}>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>03</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>/ 16</Text>
    </Box>
</Slide>
