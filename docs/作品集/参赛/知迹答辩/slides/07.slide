                <Text style={{ fontSize: 14, color: '#8FB4E8', fontFamily: 'SF Mono, Menlo, monospace' }}>infrastructure/knowledge.py:643</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#E3ECFA', lineHeight: 1.52, fontFamily: 'SF Mono, Menlo, monospace', flex: 1 }}>rankings = [<br />    self._search_fts(cleaned, ...),      # 字面<br />    self._search_expanded(cleaned, ...), # 扩写<br />    self._search_like(cleaned, ...),     # 短词<br />    self._search_vectors(cleaned, ...),  # 向量<br />]<br /># 权重：原查询字面命中最高，扩写路按推断降权<br />weights = [1.0, self.expansion_weight, 0.8, 1.0]<br />fused = rrf_fuse(rankings, k=self.rrf_k,<br />               weights=weights)[:pool]</Text>
        </Box></Box>
        <Box style={{ flex: 1, height: '100%' }}>    <Box style={{ position: 'absolute', top: 0, left: 0, width: 700, height: 468, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 18, gap: 12 }}>
