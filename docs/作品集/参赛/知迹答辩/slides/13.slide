<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', fontFamily: 'PingFang SC, Hiragino Sans GB, sans-serif' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 40, height: 56, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>知迹</Text>
        <Box style={{ width: 1, height: 16, background: '#5B8FD9' }} />
        <Text style={{ fontSize: 15, color: '#C9DDF5' }}>Agent 工程化实践</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 0, right: 40, height: 56, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#A9C6EF' }}>解法 · 收束</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 56, left: 40, width: 1200, height: 92, flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>一次提问，走完七道关</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>七道关不是模块清单，是一条链 —— 每一关都是上一关逼出来的</Text>
    </Box>

    <Box style={{ position: 'absolute', top: 176, left: 40, width: 1200, height: 104, flexDirection: 'row', alignItems: 'center', gap: 6 }}>
        <Box style={{ flex: 1, background: '#1E4FA8', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 1 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>看得懂意图</Text>
                </Box>
<Box style={{ flex: 1, background: '#3D7BD9', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 2 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>看得准资料</Text>
                </Box>
<Box style={{ flex: 1, background: '#0E3F8C', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 3 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>管得住工具</Text>
                </Box>
<Box style={{ flex: 1, background: '#4FB3A4', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 4 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>说得清出处</Text>
                </Box>
<Box style={{ flex: 1, background: '#E5B54B', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 5 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>练得下去</Text>
                </Box>
<Box style={{ flex: 1, background: '#A87F22', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 6 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>记得住</Text>
                </Box>
<Box style={{ flex: 1, background: '#6B4E9E', borderRadius: 8, padding: 14, gap: 3, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.75 }}>第 7 关</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>省得下来</Text>
                </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 300, left: 40, width: 1200, height: 112, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 24px', gap: 20 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>一次提问</Text>
        <Box style={{ width: 30, height: 3, background: '#1E4FA8' }} />
        <Text style={{ fontSize: 18, color: '#4A5568', flex: 1 }}>七道关全过，产出一个带出处的答案；中间任何一关失守，最终答案就不可信</Text>
        <Box style={{ background: '#E8EFF8', borderRadius: 6, padding: '10px 16px' }}>
            <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>最多 6 轮工具调用</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 432, left: 40, width: 1200, height: 184, flexDirection: 'row', gap: 16 }}>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 18, gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>这七关的共同点</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7 }}>
                每一关都不是「让模型更聪明」，而是<b>给模型加一道能被检查的约束</b>。
                关掉了它们，系统照样能跑 —— 只是你没法相信它的输出。
            </Text>
        </Box>
        <Box style={{ flex: 1, background: '#E8EFF8', borderRadius: 8, padding: 18, gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>为什么值得讲这些</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7 }}>
                因为这些是<b>能被单测覆盖、能被复现、能进 CI</b>的部分。
                下一段就讲：怎么证明它们真的在起作用。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 648, left: 40, width: 1200, height: 56, background: '#E8EFF8', borderTop: '2px solid #1E4FA8', flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 12 }}>
        <Box style={{ width: 4, height: 24, background: '#1E4FA8' }} />
        <Text style={{ fontSize: 19, color: '#0E3F8C', fontWeight: 'bold' }}>模型能力决定上限，工程约束决定下限 —— 知迹做的是后者</Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 8, left: 40, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>知迹 · 赛道十三 · 智慧教育</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 8, right: 40, flexDirection: 'row', alignItems: 'center', gap: 4 }}>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>13</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>/ 16</Text>
    </Box>
</Slide>
