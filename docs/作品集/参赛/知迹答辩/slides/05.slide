<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', fontFamily: 'PingFang SC, Hiragino Sans GB, sans-serif' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 40, height: 56, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>知迹</Text>
        <Box style={{ width: 1, height: 16, background: '#5B8FD9' }} />
        <Text style={{ fontSize: 15, color: '#C9DDF5' }}>Agent 工程化实践</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 0, right: 40, height: 56, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#A9C6EF' }}>解法 · 技术选型</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 56, left: 40, width: 1200, height: 92, flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>为什么用 LangGraph，而不是自己写个 while 循环</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>状态、检查点、中断、条件跳转 —— 这四件事是选型的全部理由</Text>
    </Box>

    <Box style={{ position: 'absolute', top: 168, left: 40, width: 1200, height: 468, flexDirection: 'row', gap: 20 }}>
        <Box style={{ width: 460, height: '100%' }}><Box style={{ background: '#1B2A44', borderRadius: 8, padding: 13, gap: 8, height: '100%' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#5B8FD9' }} />
                <Text style={{ fontSize: 14, color: '#8FB4E8', fontFamily: 'SF Mono, Menlo, monospace' }}>application/graph.py:311-320</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#E3ECFA', lineHeight: 1.52, fontFamily: 'SF Mono, Menlo, monospace', flex: 1 }}>builder = StateGraph(StudyState)<br />builder.add_node('route', route_node)<br />builder.add_node('plan',  plan_node)<br />builder.add_node('agent', agent_node)<br />builder.add_node('tools', tools_node)<br />builder.add_edge(START, 'route')<br />builder.add_edge('route', 'plan')<br />builder.add_edge('plan',  'agent')<br />builder.add_conditional_edges(<br />    'agent', should_continue,<br />    &#123;'tools': 'tools', END: END&#125;)<br />builder.add_edge('tools', 'agent')</Text>
        </Box></Box>
        <Box style={{ flex: 1, height: '100%' }}>    <Box style={{ position: 'absolute', top: 0, left: 0, width: 700, height: 468, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 18, gap: 12 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>画出来的回合</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>上面那段代码编译后长这样</Text>

        <Box style={{ flex: 1, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 5 }}>
                <Box style={{ width: 78, height: 44, background: '#F7F9FC', border: '2px solid #1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8' }}>START</Text>
                </Box>
                <Box style={{ width: 18, height: 22, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ flex: 1, height: 3, background: '#1E4FA8' }} />
                <Box style={{ width: 9, height: 9, background: '#1E4FA8', borderRadius: 2, transform: 'rotate(45deg)' }} />
            </Box>
                <Box style={{ width: 100, height: 56, background: '#1E4FA8', border: '2px solid #1E4FA8', borderRadius: 7, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>route</Text>
            </Box>
                <Box style={{ width: 18, height: 22, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ flex: 1, height: 3, background: '#1E4FA8' }} />
                <Box style={{ width: 9, height: 9, background: '#1E4FA8', borderRadius: 2, transform: 'rotate(45deg)' }} />
            </Box>
                <Box style={{ width: 100, height: 56, background: '#1E4FA8', border: '2px solid #1E4FA8', borderRadius: 7, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>plan</Text>
            </Box>
                <Box style={{ width: 18, height: 22, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ flex: 1, height: 3, background: '#1E4FA8' }} />
                <Box style={{ width: 9, height: 9, background: '#1E4FA8', borderRadius: 2, transform: 'rotate(45deg)' }} />
            </Box>
                <Box style={{ width: 100, height: 56, background: '#0E3F8C', border: '2px solid #1E4FA8', borderRadius: 7, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>agent</Text>
            </Box>
                <Box style={{ width: 70, height: 44, background: '#F7F9FC', border: '2px solid #1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8' }}>END</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, paddingLeft: 26 }}>
                <Box style={{ width: 22, height: 26, alignItems: 'center', justifyContent: 'center' }}>
                <Box style={{ width: 3, height: 14, background: '#3D7BD9' }} />
                <Box style={{ width: 9, height: 9, background: '#3D7BD9', borderRadius: 2, transform: 'rotate(45deg)' }} />
            </Box>
                <Box style={{ width: 120, height: 54, background: '#0E3F8C', border: '2px solid #1E4FA8', borderRadius: 7, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>tools</Text>
                </Box>
                <Box style={{ flex: 1, height: 34, border: '2px solid #3D7BD9', borderRadius: 6, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C', fontWeight: 'bold' }}>tools → agent 回到模型（结果回填）</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 14, gap: 5 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>为什么不用 while 循环自己写</Text>
            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6 }}>检查点、循环上限、中断恢复、条件跳转这四件事，用框架写是十几行；自己写是几百行状态管理，而且每加一个能力都要重写一遍。</Text>
        </Box>
    </Box></Box>
    </Box>

    <Box style={{ position: 'absolute', top: 648, left: 40, width: 1200, height: 56, background: '#E8EFF8', borderTop: '2px solid #1E4FA8', flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 12 }}>
        <Box style={{ width: 4, height: 24, background: '#1E4FA8' }} />
        <Text style={{ fontSize: 19, color: '#0E3F8C', fontWeight: 'bold' }}>框架负责编排，决策留给自己 —— 我要的是控制权，不是省事</Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 8, left: 40, flexDirection: 'row', alignItems: 'center' }}>
