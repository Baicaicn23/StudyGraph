<Box style={{ position: 'absolute', top: 72, right: 40, background: '#1E4FA8', borderRadius: 6, padding: '7px 14px', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>第 6 关</Text>
        <Box style={{ width: 1, height: 14, background: '#5B8FD9' }} />
        <Text style={{ fontSize: 15, color: '#C9DDF5' }}>记得住</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 168, left: 40, width: 1200, height: 468, flexDirection: 'row', gap: 20 }}>
        <Box style={{ width: 460, height: '100%' }}><Box style={{ background: '#1B2A44', borderRadius: 8, padding: 13, gap: 8, height: '100%' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#5B8FD9' }} />
                <Text style={{ fontSize: 14, color: '#8FB4E8', fontFamily: 'SF Mono, Menlo, monospace' }}>domain/scheduling.py:15-18</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#E3ECFA', lineHeight: 1.52, fontFamily: 'SF Mono, Menlo, monospace', flex: 1 }}>_RATING = &#123;<br />    'again': (-10,        0),            # 掌握度, 间隔秒<br />    'hard':  (-3,  24 * 60 * 60),      # 1 天<br />    'good':  (+5,   3 * 24 * 60 * 60), # 3 天<br />    'easy':  (+10,  7 * 24 * 60 * 60), # 7 天<br />&#125;<br />def review(rating, current_mastery):<br />    delta, interval = _RATING[rating]<br />    return ReviewResult(<br />        mastery=clamp_mastery(current + delta),<br />        due_in_seconds=interval)</Text>
        </Box></Box>
        <Box style={{ flex: 1, height: '100%' }}>    <Box style={{ position: 'absolute', top: 0, left: 0, width: 700, height: 468, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 18, gap: 12 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>自评四档 → 下次什么时候见</Text>
        <Box style={{ flexDirection: 'row', gap: 10, height: 176, alignItems: 'flex-end' }}>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 10, gap: 3, height: 64, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F' }}>again</Text>
                    <Text style={{ fontSize: 13, color: '#D9534F' }}>−10</Text>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>立即</Text>
                </Box>
<Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 10, gap: 3, height: 98, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#A87F22' }}>hard</Text>
                    <Text style={{ fontSize: 13, color: '#A87F22' }}>−3</Text>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>1 天</Text>
                </Box>
<Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 10, gap: 3, height: 132, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#3D7BD9' }}>good</Text>
                    <Text style={{ fontSize: 13, color: '#3D7BD9' }}>+5</Text>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>3 天</Text>
                </Box>
<Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 10, gap: 3, height: 164, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>easy</Text>
                    <Text style={{ fontSize: 13, color: '#1E4FA8' }}>+10</Text>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>7 天</Text>
                </Box>
        </Box>
        <Box style={{ background: '#E8EFF8', borderRadius: 6, padding: 12, gap: 4 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C' }}>整个排期是纯函数</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.55 }}>不调模型、不随机 —— 同样的输入永远得到同样的排期，所以能被单测覆盖</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: 12, gap: 4 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C' }}>长期记忆按课程隔离</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.55 }}>学期的数据不串到下学期；写入前先问一句要不要记</Text>
        </Box>
    </Box></Box>
    </Box>

    <Box style={{ position: 'absolute', top: 648, left: 40, width: 1200, height: 56, background: '#E8EFF8', borderTop: '2px solid #1E4FA8', flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 12 }}>
