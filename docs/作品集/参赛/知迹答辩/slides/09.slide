<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, position: 'relative', fontFamily: 'PingFang SC' }}>

  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#1E4FA8' }} />
  <Text style={{ position: 'absolute', left: 76, top: 21, fontSize: 15, color: '#C9D8EF', letterSpacing: 1 }}>知迹 · 答辩汇报</Text>
  <Text style={{ position: 'absolute', left: 1010, top: 21, width: 194, textAlign: 'right', fontSize: 15, color: '#C9D8EF' }}>赛道十三 · 智慧教育</Text>

  <Box style={{ position: 'absolute', left: 76, top: 92, width: 1128 }}>
    <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#0E3F8C' }}>六件事：两件做好、三件半成、一件没做</Text>
    <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 10 }}>这一页是给自己挑毛病——说清哪里还没做好，比说自己很强更可信</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 192, width: 1128, height: 36, flexDirection: 'row', alignItems: 'center', background: '#F0F5FC', borderRadius: 6, paddingLeft: 14 }}>
    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0E3F8C', width: 430 }}>事项</Text>
    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0E3F8C', width: 110 }}>状态</Text>
    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0E3F8C', width: 545 }}>依据 / 还差什么</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 232, width: 1128, height: 348, flexDirection: 'column' }}>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>断了能接上（可恢复执行）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 110 }}>做好</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>状态图 + 断点存档；中断恢复有专门的测试</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>找资料准（混合检索）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 110 }}>做好</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>35 道题考卷；接真实模型时 35 道全对</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>动作可控（工具治理）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#BA7517', width: 110 }}>半成</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>权限两道 + 超时兜底；还缺「按具体参数」的细权限</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>长对话记得住（上下文压缩）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#BA7517', width: 110 }}>半成</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>有 240 字纪要；还没做「关键事实外置成笔记」</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, borderBottom: '1px solid #E5E7EB', paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>记得住人（长期记忆）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#BA7517', width: 110 }}>半成</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>按课程分开存 + 写入前确认；缺「过期与删除」</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 58, paddingLeft: 14 }}>
      <Text style={{ fontSize: 14.5, color: '#1A2230', width: 430 }}>整次会话算不算成功（任务级评测）</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#D9534F', width: 110 }}>没做</Text>
      <Text style={{ fontSize: 13.5, color: '#4A5568', width: 545 }}>现在只测「找到没」「分类对不对」，不测「这轮有用没」</Text>
    </Box>

  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 596, width: 1128, height: 50, background: '#0E3F8C', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
