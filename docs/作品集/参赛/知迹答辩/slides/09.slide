<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, position: 'relative', fontFamily: 'PingFang SC' }}>

  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#1E4FA8' }} />
  <Text style={{ position: 'absolute', left: 76, top: 21, fontSize: 15, color: '#C9D8EF', letterSpacing: 1 }}>知迹 · 答辩汇报</Text>
  <Text style={{ position: 'absolute', left: 1010, top: 21, width: 194, textAlign: 'right', fontSize: 15, color: '#C9D8EF' }}>04 · 实际使用与指标</Text>

  <Box style={{ position: 'absolute', left: 76, top: 92, width: 1128 }}>
    <Text style={{ fontSize: 31, fontWeight: 'bold', color: '#0E3F8C' }}>四步走完一个学习周期：入库、溯源、记错因、到期复习</Text>
    <Text style={{ fontSize: 15.5, color: '#4A5568', marginTop: 10 }}>左图为系统真实界面（非设计稿）：7 个学科库、24 份资料、46 个可检索片段</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 190, width: 640 }}>
    <Box style={{ width: 640, height: 288, border: '1px solid #D6DCE5', borderRadius: 6, overflow: 'hidden' }}>
      <Image src="assets/ui-knowledge.png" style={{ width: 638, height: 286, objectFit: 'cover' }} />
    </Box>
    <Text style={{ fontSize: 12, color: '#8B97A8', marginTop: 8 }}>
      知识库页：左学科目录、中资料列表（PDF 与 Word 并列）、右可直接就着当前库提问
    </Text>
  </Box>

  <Box style={{ position: 'absolute', left: 748, top: 190, width: 456, height: 336, flexDirection: 'column' }}>

    <Box style={{ flexDirection: 'column', height: 82, borderLeft: '3px solid #1E4FA8', paddingLeft: 12, paddingTop: 4 }}>
      <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#1A2230' }}>一、讲义入库</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.6, marginTop: 5 }}>PDF / Word / PPT / Excel 秒传；板书照片经视觉转写后入库</Text>
    </Box>

    <Box style={{ flexDirection: 'column', height: 82, borderLeft: '3px solid #1E4FA8', paddingLeft: 12, paddingTop: 4 }}>
      <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#1A2230' }}>二、就着资料提问</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.6, marginTop: 5 }}>回答标注出自哪份资料、第几页；原件可内联打开核对</Text>
    </Box>

    <Box style={{ flexDirection: 'column', height: 82, borderLeft: '3px solid #1E4FA8', paddingLeft: 12, paddingTop: 4 }}>
      <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#1A2230' }}>三、错题按错因归档</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.6, marginTop: 5 }}>概念混淆 / 步骤遗漏 / 条件误读 / 计算失误 / 表述不清</Text>
    </Box>

    <Box style={{ flexDirection: 'column', height: 82, borderLeft: '3px solid #3D7BD9', paddingLeft: 12, paddingTop: 4 }}>
      <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#1A2230' }}>四、到期自动复盘</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.6, marginTop: 5 }}>今日复习只列到期题与薄弱学科；日程负责"什么时候做"</Text>
    </Box>

  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 500, width: 1128, height: 24, flexDirection: 'row', alignItems: 'center', background: '#F0F5FC', borderRadius: 6, paddingLeft: 14 }}>
    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#1E4FA8', width: 220 }}>演示数据规模</Text>
    <Text style={{ fontSize: 12.5, color: '#4A5568', width: 280 }}>7 个学科库 / 24 份资料</Text>
    <Text style={{ fontSize: 12.5, color: '#4A5568', width: 280 }}>46 个检索片段（全部带出处）</Text>
    <Text style={{ fontSize: 12.5, color: '#4A5568', width: 320 }}>5 门课程 / 7 条误区 / 3 条日程</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 76, top: 540, width: 1128, height: 70, flexDirection: 'row', gap: 20 }}>

    <Box style={{ width: 554, flexDirection: 'column', borderLeft: '3px solid #1E4FA8', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1A2230' }}>可核验的出处</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.65, marginTop: 5 }}>
        PDF 与 PPT 按页切块，引用精确到「第 N 页」——这是"有据可查"与"看着像"的分界。
      </Text>
    </Box>

    <Box style={{ width: 554, flexDirection: 'column', borderLeft: '3px solid #3D7BD9', paddingLeft: 14 }}>
      <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#1A2230' }}>可复现的过程</Text>
      <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.65, marginTop: 5 }}>
        每个回合的步骤流与工具调用都留痕，可回放、可归因，不依赖演讲者记忆。
      </Text>
    </Box>

  </Box>

  <Box style={{ position: 'absolute', left: 76, bottom: 24, width: 1128, height: 22, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>截图取自演示数据（zhiji-demo --reset 可重建同一份数据）</Text>
    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0E3F8C' }}>09 / 11</Text>
  </Box>

</Slide>
